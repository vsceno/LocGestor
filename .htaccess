# LocGestor
Options -Indexes
DirectoryIndex index.php

# Configuração, documentação e arquivos de apoio nunca são servidos
<FilesMatch "^(config.*\.php|README\.md)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sql|bat|log|md|gitignore|gitattributes)$">
    Require all denied
</FilesMatch>

# Pastas ocultas (.git, .claude) respondem como inexistentes
RedirectMatch 404 /\.(git|claude)(/|$)
