# LocGestor
Options -Indexes
DirectoryIndex index.php

# Configuração, documentação e arquivos de apoio nunca são servidos
<FilesMatch "^(config.*\.php|README\.md)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sql|bat|log|md|gitignore|gitattributes)$">
    Require all denied
</FilesMatch>

# Aplicativo (PWA): tipo do manifesto; o service worker é sempre conferido no servidor
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

# Pastas ocultas (.git, .claude) respondem como inexistentes
RedirectMatch 404 /\.(git|claude)(/|$)

# Laravel: a pasta laravel/ (com .env, código e vendor) nunca é servida direto.
# Só a parte pública (laravel/public) responde, pelo endereço /novo.
RedirectMatch 404 ^/laravel(/|$)
# Qualquer .env, em qualquer pasta, também não
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
