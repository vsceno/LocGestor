APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Caminho público dos arquivos do build quando o sistema não fica na raiz do site (ex.: /novo). Vazio = raiz.
ASSET_URL=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/novo
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# LocGestor: banco e papel do sistema das locadoras (locgestor_app). Preencha a senha com a que foi digitada no
# database/instalar.bat (ou no 00_roles.sql). Nunca rode "php artisan migrate" neste banco: a estrutura vem de database/.
# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=locgestor
# DB_USERNAME=locgestor_app
# DB_PASSWORD=

# Painel da plataforma: papel próprio (locgestor_plataforma), com a senha do 00_roles.sql
# DB_PLATAFORMA_USERNAME=locgestor_plataforma
# DB_PLATAFORMA_PASSWORD=

# Cadastro público, termos de uso, dados da LocGestor (recibos), logomarca e nome do sistema: não ficam no .env.
# São definidos na tela "Configurações da LocGestor" do painel da plataforma (gravados no banco, com auditoria).

# Cobrança das mensalidades pelo Asaas (veja o README, seção 10.6). Comece em sandbox para testar.
# LOCGESTOR_ASAAS_AMBIENTE=sandbox
# LOCGESTOR_ASAAS_CHAVE=
# LOCGESTOR_ASAAS_WEBHOOK_TOKEN=
# LOCGESTOR_ASAAS_DIAS_ANTES=10
# LOCGESTOR_ASAAS_URL=

# HTTPS obrigatório (produção, com certificado): redireciona http para https e manda o navegador usar só HTTPS.
# Use junto com APP_URL=https://... e SESSION_SECURE_COOKIE=true. Local: deixe false.
# LOCGESTOR_FORCAR_HTTPS=false

# Pasta das fotos de vistoria, assinaturas e logomarcas (padrão: storage/ na raiz do projeto).
# Em produção, prefira uma pasta fora da pasta do site.
# LOCGESTOR_PASTA_ARQUIVOS=

# Proxies confiáveis (IPs separados por vírgula), só se houver Cloudflare ou balanceador na frente do servidor.
# Vazio = nenhum proxy confiável (padrão seguro).
# LOCGESTOR_PROXIES=

